# ============================================================
#   AgriCast — .gitignore
#   Covers: Spring Boot, FastAPI, React, Python Scraper,
#           PostgreSQL, Docker, OS & IDE files
# ============================================================


# ?????????????????????????????????????????
#  ENVIRONMENT & SECRETS (never commit!)
# ?????????????????????????????????????????
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
secrets/


# ?????????????????????????????????????????
#  SPRING BOOT / JAVA (backend/)
# ?????????????????????????????????????????
target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# Maven
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Spring Boot config with secrets
backend/src/main/resources/application-prod.properties
backend/src/main/resources/application-local.properties


# ?????????????????????????????????????????
#  PYTHON — FastAPI ML Service & Scraper
# ?????????????????????????????????????????
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# Virtual environments
venv/
.venv/
env/
ENV/
.env/
ml-service/venv/
scraper/venv/

# Python packaging
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# PyInstaller
*.manifest
*.spec

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
nosetests.xml

# Jupyter
.ipynb_checkpoints/
*.ipynb

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Prophet / ML model artifacts
*.pkl
*.joblib
*.h5
*.pt
*.pth
models/saved/
ml-service/models/


# ?????????????????????????????????????????
#  SCRAPER — CSV DATA FILES
# ?????????????????????????????????????????
# Raw data files — store in cloud storage, not Git
scraper/data/*.csv
scraper/data/*.xlsx
scraper/data/*.json
scraper/logs/


# ?????????????????????????????????????????
#  REACT FRONTEND (frontend/)
# ?????????????????????????????????????????
node_modules/
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.pnp
frontend/.pnp.js

# Testing
frontend/coverage/

# Production build
frontend/.next/
frontend/out/

# Runtime
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Cache
.npm
.eslintcache
.stylelintcache
.parcel-cache/
.cache/
frontend/.cache/

# Optional: lock files (keep one, ignore the other)
# package-lock.json
# yarn.lock


# ?????????????????????????????????????????
#  POSTGRESQL / DATABASE
# ?????????????????????????????????????????
*.sql.bak
*.dump
*.pgdump
db/backups/
pgdata/


# ?????????????????????????????????????????
#  DOCKER
# ?????????????????????????????????????????
# Keep docker-compose.yml but ignore override files
docker-compose.override.yml
docker-compose.local.yml
.docker/


# ?????????????????????????????????????????
#  LOGS
# ?????????????????????????????????????????
*.log
logs/
log/
*.log.*


# ?????????????????????????????????????????
#  IDEs & EDITORS
# ?????????????????????????????????????????

# IntelliJ IDEA / Spring Tool Suite
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# Eclipse
.project
.classpath
.settings/
.factorypath
bin/

# NetBeans
nbproject/
nbbuild/
nbdist/
.nb-gradle/


# ?????????????????????????????????????????
#  OPERATING SYSTEM
# ?????????????????????????????????????????

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~


# ?????????????????????????????????????????
#  MISCELLANEOUS
# ?????????????????????????????????????????
*.tmp
*.temp
*.swp
*.bak
*.orig
*.rej
.history/
tmp/
temp/